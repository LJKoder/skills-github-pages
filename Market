            len(a) - 2
        ):

            if not (

                np.isfinite(a[j])
                and
                np.isfinite(a[j + 1])
                and
                np.isfinite(a[j + 2])
            ):

                continue

            if (

                a[j] < 0

                and

                a[j + 1] >= 0

                and

                a[j + 2] >= 0
            ):

                absolute_turn = (

                    start
                    + j
                    + 1
                )

                turn_relative = (

                    absolute_turn
                    - minimum_index
                )


    turn_rows.append({

        "EventID":
            event_id,

        "Ticker":
            ticker,

        "Success":
            event["Success"],

        "FutureReturn":
            event["FutureReturn"],

        "AccelerationTurnRelative":
