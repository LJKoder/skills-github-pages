# =============================================================================
# OPTIONAL STRUCTURAL SMOOTHING
# =============================================================================

def supersmoother(
    series,
    period=10
):

    series = (
        pd.Series(series)
        .astype(float)
    )

    vals = series.values

    n = len(vals)

    out = np.full(
        n,
        np.nan
    )

    if n == 0:

        return pd.Series(
            out,
            index=series.index
        )

    if period <= 1:

        return series.copy()

    a1 = np.exp(
        -np.pi
        * np.sqrt(2)
        / period
    )

    b1 = (
        2.0
        * a1
        * np.cos(
            np.sqrt(2)
            * np.pi
            / period
        )
    )

    c3 = -a1 * a1

    c2 = b1

    c1 = (
        1.0
        - c2
        - c3
    )

    for i in range(n):

        if i == 0:

            out[i] = vals[i]

        elif i == 1:

            out[i] = vals[i]

        else:

            if not np.isfinite(
                vals[i]
            ):

                out[i] = out[i - 1]

            else:

                price_avg = (
                    vals[i]
                    + vals[i - 1]
                ) / 2.0

                out[i] = (

                    c1
                    * price_avg

                    + c2
                    * out[i - 1]

                    + c3
                    * out[i - 2]
                )

    return pd.Series(
        out,
        index=series.index
    )


# =============================================================================
# CAUSAL NORMALIZATION
