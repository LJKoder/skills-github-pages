                    g.loc[
                        previous_max,
                        "Date"
                    ]
                    if previous_max is not None
                    else pd.NaT
                ),

            "MaximumIndex":
                subsequent_max,

            "MaximumDate":
                g.loc[
                    subsequent_max,
                    "Date"
                ],

            "WeeksToMaximum":
                subsequent_max - mi,

            "FutureReturn":
                future_return,

            "FutureLogRise":
                future_log_rise,

            "DescentReturn":
                descent_return,

            "WeeksFromPreviousPeak":
                weeks_from_previous_peak,

            "MinimumSmooth":
                minimum_value,

            # -----------------------------------------------------------------
            # Causal trajectory state
            # -----------------------------------------------------------------

            "Velocity":
                g.loc[
                    mi,
                    "velocity"
                ],

            "Acceleration":
                g.loc[
                    mi,
                    "acceleration"
                ],

            "AccelerationSmooth":
