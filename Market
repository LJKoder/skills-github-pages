# =============================================================================
# GENERIC QUINTILE FUNCTION
# =============================================================================

def safe_qcut(
    series,
    q,
    prefix
):

    x = pd.to_numeric(
        series,
        errors="coerce"
    )

    result = pd.Series(
        index=series.index,
        dtype="object"
    )

    valid = x.notna()

    if valid.sum() < q:

        result.loc[valid] = "All"

        return result

    try:

        cats = pd.qcut(
            x.loc[valid],
            q=q,
            duplicates="drop"
        )

        n_bins = len(
            cats.cat.categories
        )

        labels = [

            f"{prefix}{i + 1}"

            for i in range(n_bins)
        ]

        cats = (
            cats
            .cat
            .rename_categories(labels)
        )

        result.loc[valid] = (
            cats.astype(str)
        )

    except Exception:

        ranks = (

            x.loc[valid]
            .rank(
                method="first",
                pct=True
            )
        )

        result.loc[valid] = (

            np.ceil(
                ranks * q
            )
            .clip(
                1,
                q
            )
            .astype(int)
            .map(
                lambda z:
                f"{prefix}{z}"
            )
        )

    return result


