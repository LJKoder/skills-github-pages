aligned_rows = []


for event_id, event in events.iterrows():

    ticker = event["Ticker"]

    minimum_index = int(
        event["MinimumIndex"]
    )

    g = (

        df[
            df["Ticker"] == ticker
        ]
        .sort_values("Date")
        .reset_index(drop=True)
    )

    if (
        minimum_index < 0
        or
        minimum_index >= len(g)
    ):

        continue

    lo = max(
        0,
        minimum_index
        - PRE_WINDOW_WEEKS
    )

    hi = min(
        len(g),
        minimum_index
        + POST_WINDOW_WEEKS
        + 1
    )

    window = (
        g
        .iloc[
            lo:hi
        ]
        .copy()
    )

    window["RelativeWeek"] = (

        np.arange(
            lo,
            hi
        )
        - minimum_index
    )

    window["EventID"] = event_id

    window["Success"] = (
        event["Success"]
    )

    window["FutureReturn"] = (
        event["FutureReturn"]
    )

    # -------------------------------------------------------------------------
    # Structural distance from minimum
    # -------------------------------------------------------------------------

    minimum_smooth = (
        event["MinimumSmooth"]
    )

    window[
        "DistanceFromMinimum"
    ] = (

        window["smooth"]
        - minimum_smooth
    )

    # -------------------------------------------------------------------------
    # Percentage distance from minimum
    # -------------------------------------------------------------------------

    window[
        "DistanceFromMinimumPct"
    ] = (

        np.exp(
            window["DistanceFromMinimum"]
        )
        - 1.0
    )

    aligned_rows.append(

        window[

            [

                "Ticker",
                "Date",

                "smooth",

                "velocity",
                "acceleration",
                "acceleration_smooth",

