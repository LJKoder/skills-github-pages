print("=" * 80)


def add_causal_volatility(g):

    g = (
        g
        .sort_values("Date")
        .copy()
    )

    # -------------------------------------------------------------------------
    # Weekly log return
    # -------------------------------------------------------------------------

    g["weekly_log_return"] = (
        g["log_weekly_value"]
        .diff()
    )

    # -------------------------------------------------------------------------
    # Rolling volatility
    # -------------------------------------------------------------------------

    for window in VOLATILITY_WINDOWS:

        g[f"volatility_{window}w"] = (

            g["weekly_log_return"]
            .rolling(
                window=window,
                min_periods=max(
                    5,
                    window // 2
                )
            )
            .std()
        )

    # -------------------------------------------------------------------------
    # Volatility change
    # -------------------------------------------------------------------------

    for window in VOLATILITY_WINDOWS:

        volatility = (
            g[f"volatility_{window}w"]
        )

        g[
            f"volatility_{window}w_change"
        ] = (
            volatility.diff()
        )

        # Percentage change is retained as a diagnostic.
        # It can become unstable when volatility is extremely small,
        # so it is NOT used as the primary measure.

        g[
            f"volatility_{window}w_pct_change"
        ] = (
            volatility.pct_change()
        )

    return g


