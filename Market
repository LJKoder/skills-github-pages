def find_local_extrema(
    values,
    min_separation=10
):

    s = (
        pd.Series(values)
        .reset_index(drop=True)
    )

    minima = []

    maxima = []

    last_min = (
        -min_separation
    )

    last_max = (
        -min_separation
    )

    for i in range(
        1,
        len(s) - 1
    ):

        if not np.isfinite(
            s.iloc[i - 1]
        ):
            continue

        if not np.isfinite(
            s.iloc[i]
        ):
            continue

        if not np.isfinite(
            s.iloc[i + 1]
        ):
            continue

        is_min = (

            s.iloc[i]
            <= s.iloc[i - 1]

            and

            s.iloc[i]
            < s.iloc[i + 1]
        )

        is_max = (

            s.iloc[i]
            >= s.iloc[i - 1]

            and

            s.iloc[i]
            > s.iloc[i + 1]
        )

        if is_min:

            if (
                i - last_min
                >= min_separation
            ):

                minima.append(i)

                last_min = i

        if is_max:

            if (
                i - last_max
                >= min_separation
            ):

                maxima.append(i)

                last_max = i

    return minima, maxima


