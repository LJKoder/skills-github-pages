        find_local_extrema(
            structural_signal.values,
            MIN_SEPARATION_WEEKS
        )
    )

    # -------------------------------------------------------------------------
    # Examine every minimum
    # -------------------------------------------------------------------------

    for mi in minima:

        # ---------------------------------------------------------------------
        # Previous maximum
        # ---------------------------------------------------------------------

        previous_maxima = [
            x
            for x in maxima
            if x < mi
        ]

        if previous_maxima:

            previous_max = max(
                previous_maxima
            )

        else:

            previous_max = None

        # ---------------------------------------------------------------------
        # Subsequent maxima
        # ---------------------------------------------------------------------

        future_maxima = [

            x
            for x in maxima

            if (
                x > mi
                and
                x <= mi + MAX_RUN_WEEKS
            )
        ]

        if not future_maxima:
            continue

        # Highest structural maximum

        subsequent_max = max(

            future_maxima,

            key=lambda x:
            structural_signal.iloc[x]
        )

        # ---------------------------------------------------------------------
        # Structural values
        # ---------------------------------------------------------------------

        minimum_value = (
            structural_signal.iloc[mi]
        )

        maximum_value = (
            structural_signal.iloc[
                subsequent_max
            ]
        )

