symmetry_rows = []


for event_id, event in events.iterrows():

    ticker = event["Ticker"]

    minimum_index = int(
        event["MinimumIndex"]
    )

    maximum_index = int(
        event["MaximumIndex"]
    )

    g = (

        df[
            df["Ticker"] == ticker
        ]
        .sort_values("Date")
        .reset_index(drop=True)
    )

    # -------------------------------------------------------------------------
    # Local velocity symmetry
    # -------------------------------------------------------------------------

    pre_start = max(
        0,
        minimum_index
        - SYMMETRY_WINDOW
    )

    pre = g.iloc[
        pre_start:
        minimum_index
    ]

    post_end = min(
        len(g),
        minimum_index
        + SYMMETRY_WINDOW
        + 1
    )

    post = g.iloc[
        minimum_index + 1:
        post_end
    ]

    pre_v = (

        pd.to_numeric(
            pre["velocity"],
            errors="coerce"
        )
        .dropna()
    )

    post_v = (

        pd.to_numeric(
            post["velocity"],
            errors="coerce"
        )
        .dropna()
    )

    if (
        len(pre_v) >= 3
        and
        len(post_v) >= 3
    ):

        falling_speed = np.mean(
            np.abs(pre_v)
        )

        rising_speed = np.mean(
            np.abs(post_v)
        )

        if (
            falling_speed > 0
            and
            rising_speed > 0
        ):

            velocity_symmetry = (

                min(
                    falling_speed,
                    rising_speed
                )
                /
                max(
                    falling_speed,
                    rising_speed
                )
            )

        else:

            velocity_symmetry = np.nan

    else:

        falling_speed = np.nan

        rising_speed = np.nan

        velocity_symmetry = np.nan

    # -------------------------------------------------------------------------
    # Structural symmetry
    # -------------------------------------------------------------------------

    previous_maximum_index = (

        event[
            "PreviousMaximumIndex"
        ]
    )

    if pd.notna(
        previous_maximum_index
    ):

        previous_maximum_index = int(
            previous_maximum_index
        )

        descent = (
            event["DescentReturn"]
        )

    else:

        descent = np.nan

    rebound = (
        event["FutureReturn"]
    )

    if (
        np.isfinite(descent)
        and
        descent > 0
        and
        rebound > 0
    ):

        structural_symmetry = (

            min(
                descent,
                rebound
            )
            /
            max(
                descent,
                rebound
            )
        )

    else:

        structural_symmetry = np.nan

    symmetry_rows.append({

        "EventID":
            event_id,

        "Ticker":
            ticker,

        "Success":
            event["Success"],

        "FutureReturn":
            event["FutureReturn"],

        "PreVelocityMagnitude":
            falling_speed,

        "PostVelocityMagnitude":
            rising_speed,

        "VelocitySymmetry":
            velocity_symmetry,

        "DescentReturn":
            descent,

        "ReboundReturn":
            rebound,

        "StructuralSymmetry":
            structural_symmetry
    })


