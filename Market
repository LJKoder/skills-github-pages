        # Future rise
        # ---------------------------------------------------------------------

        future_log_rise = (

            maximum_value
            - minimum_value
        )

        future_return = (

            np.exp(
                future_log_rise
            )
            - 1.0
        )

        if not np.isfinite(
            future_return
        ):
