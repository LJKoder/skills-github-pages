def add_causal_normalization(g):

    g = g.copy()

    # -------------------------------------------------------------------------
    # Velocity scale
    # -------------------------------------------------------------------------

    velocity_abs = (
        g["velocity"]
        .abs()
    )

    velocity_scale = (

        velocity_abs
        .rolling(
            NORMALIZATION_WINDOW,
            min_periods=5
        )
        .median()
    )

    velocity_scale = (
        velocity_scale
        .clip(
            lower=NORMALIZATION_FLOOR
        )
    )

    # -------------------------------------------------------------------------
    # Acceleration scale
    # -------------------------------------------------------------------------

    acceleration_abs = (
        g["acceleration"]
        .abs()
    )

    acceleration_scale = (

        acceleration_abs
        .rolling(
            NORMALIZATION_WINDOW,
            min_periods=5
        )
        .median()
    )

    acceleration_scale = (
        acceleration_scale
        .clip(
            lower=NORMALIZATION_FLOOR
        )
    )

    # -------------------------------------------------------------------------
    # Normalized variables
    # -------------------------------------------------------------------------

    g["velocity_scale"] = (
        velocity_scale
    )

    g["acceleration_scale"] = (
        acceleration_scale
    )

    g["velocity_normalized"] = (
        g["velocity"]
        / velocity_scale
    )

    g["acceleration_normalized"] = (
        g["acceleration"]
        / acceleration_scale
    )

    # -------------------------------------------------------------------------
    # Normalized range
    # -------------------------------------------------------------------------

    range_scale = (

        g["weekly_log_range"]
        .rolling(
            NORMALIZATION_WINDOW,
            min_periods=5
        )
        .median()
        .clip(
            lower=NORMALIZATION_FLOOR
        )
    )

    g["range_scale"] = (
        range_scale
    )

    g["range_normalized"] = (
        g["weekly_log_range"]
        / range_scale
    )

    # -------------------------------------------------------------------------
    # Range / velocity
    # -------------------------------------------------------------------------

    ratio_abs = (
        g["range_to_velocity"]
        .abs()
    )

    ratio_scale = (

        ratio_abs
        .rolling(
            NORMALIZATION_WINDOW,
            min_periods=5
        )
        .median()
        .clip(
            lower=NORMALIZATION_FLOOR
        )
    )

    g["range_velocity_scale"] = (
        ratio_scale
    )

    g["range_velocity_normalized"] = (

        g["range_to_velocity"]
        / ratio_scale
    )

    return g


